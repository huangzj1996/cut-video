# Option A: Claude subscription OAuth token (run `claude setup-token` on your host).
# Leave empty when using a custom Anthropic-compatible gateway such as DeepSeek.
CLAUDE_CODE_OAUTH_TOKEN=
# Option B: Anthropic API key.
# ANTHROPIC_API_KEY=

# Option C: DeepSeek via its Anthropic-compatible gateway.
# The key comes from https://platform.deepseek.com/api_keys
# If left empty, Sandcastle falls back to the same variable in your host env.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# Agent model is passed explicitly in main.mts; these cover Claude Code's
# internal model calls (haiku/sonnet/opus aliases).
ANTHROPIC_MODEL=deepseek-flash
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-pro
# GitHub personal access token — the agent uses it to read and manage GitHub Issues
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Issues (Read and write) and Metadata (Read)
GH_TOKEN=
