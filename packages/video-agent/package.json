{
  "name": "@miaoma/video-agent",
  "version": "0.1.0",
  "private": true,
  "description": "妙剪 Magicut 视频剪辑智能体核心（媒体处理 + LangGraph）",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./llm": {
      "types": "./src/llm/index.ts",
      "import": "./src/llm/index.ts",
      "default": "./src/llm/index.ts"
    },
    "./workflow": {
      "types": "./src/workflow/index.ts",
      "import": "./src/workflow/index.ts",
      "default": "./src/workflow/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint": "1.2.1",
    "@langchain/openai": "1.5.0",
    "@miaoma/video-project": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
